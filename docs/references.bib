% Cynthium documentation references.
%
% BibTeX entries for the data sources cited in the documentation.
% Cite them anywhere in the docs with the :cite:`key` role, e.g.
%
%   Average Temperature, retrieved from Diviner data :cite:`diviner2010`.
%
% The full list is rendered on the References page (docs/references.rst).
% To add a new source, drop a BibTeX entry in here and cite its key.

% The Average Temperature layer uses the seasonal polar temperature maps
% from Williams et al. (2019), which are compiled from Diviner (DLRE)
% observations. Cite this entry; the Diviner instrument paper (Paige et al.
% 2010) is only the underlying instrument reference.
@article{williams2019,
	author  = {Williams, J.-P. and Greenhagen, B. T. and Paige, D. A. and Schorghofer, N. and Sefton-Nash, E. and Hayne, P. O. and Lucey, P. G. and Siegler, M. A. and Aye, K.-Michael},
	title   = {Seasonal polar temperatures on the Moon},
	journal = {Journal of Geophysical Research: Planets},
	year    = {2019},
	volume  = {124},
	number  = {10},
	pages   = {2505--2521},
	doi     = {10.1029/2019JE006028},
}

